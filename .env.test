# Modèle de configuration — environnement TEST
# Fichier autonome et complet (aucune dépendance à .env.shared, supprimé).
# Activation : scripts/use-env.sh test (copie ce fichier vers .env, racine, + symlinks front/.env et search_api_solr/.env)

ENVIRONMENT=test
NODE_ENV=test

# --- Général / backend ---
DEBUG=true
AUTO_RELOAD=false
LOG_LEVEL=DEBUG
DISABLE_AUTH=true

# --- URLs de service ---
# Les tests backend tournent en dehors de Docker (uvicorn direct sur 8007).
API_BASE_URL=http://localhost:8007
NEXT_PUBLIC_API_URL=http://localhost:8007
FRONTEND_URL=http://localhost:3003
REACT_APP_MOCK_API=true

# Ports exposés par Docker Compose (réutilise la stack dev pour les tests)
API_PORT=8003
FRONTEND_PORT=3003
POSTGRES_PORT=5435
REDIS_PORT=6376

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:3003,http://127.0.0.1:3000,http://127.0.0.1:3003,http://0.0.0.0:3000,http://0.0.0.0:3003,http://localhost:8003

# --- Solr ---
SOLR_URL=http://solr-test:8983/solr
SOLR_BASE_URL=https://solrslave-sec.labocleo.org/solr/documents
SOLR_COLLECTION=searchv2_test

# --- Base de données / cache ---
DATABASE_URL=postgresql://search_user:search_password@postgres:5432/search_db
TEST_DATABASE_URL=sqlite:///:memory:
REDIS_URL=redis://redis:6379/0
REDIS_ENABLED=true
REDIS_TTL_SEARCH=300
REDIS_TTL_SUGGEST=3600
REDIS_TTL_PERMISSIONS=1800

# --- Sécurité applicative ---
# Auth désactivée en test (DISABLE_AUTH=true) : aucun secret requis.
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Auth externe ---
AUTH_API_URL=https://auth.openedition.org/auth_by_url/

# --- LDAP (interface testable même si le backend renvoie 503) ---
LDAP_ENABLED=false
LDAP_URL=ldaps://ldap.example.org:636
LDAP_BASE_DN=dc=example,dc=org
LDAP_BIND_DN=cn=service,dc=example,dc=org
LDAP_BIND_PASSWORD=
LDAP_USER_FILTER=(uid={username})
LDAP_EMAIL_ATTR=mail
LDAP_FIRSTNAME_ATTR=givenName
LDAP_LASTNAME_ATTR=sn
LDAP_EMAIL_CONFLICT_STRATEGY=reject
NEXT_PUBLIC_LDAP_ENABLED=true

# --- SSO OIDC (désactivé par défaut) ---
SSO_OIDC_ENABLED=false
SSO_OIDC_ISSUER=https://sso.example.org
SSO_OIDC_CLIENT_ID=openedition-search
SSO_OIDC_CLIENT_SECRET=
SSO_OIDC_REDIRECT_URI=http://localhost:8003/auth/sso/callback
SSO_OIDC_SCOPES=openid email profile
NEXT_PUBLIC_SSO_ENABLED=false

# --- Divers tests ---
TEST_TIMEOUT=10000
TEST_RETRIES=2
RATE_LIMIT=10000
