{% if facets %}
<aside aria-label="Filtres de recherche" class="bg-card border border-border rounded-3xl p-6 sticky top-24 premium-shadow w-full">
  {% for facet_id, facet_data in facets.items() %}
  {% set buckets = facet_data.buckets if facet_data.buckets else [] %}
  {% if buckets %}
  {% set section_id = "facet-" ~ facet_id %}
  <section class="mb-6 last:mb-0" aria-labelledby="facet-label-{{ facet_id }}">
    <h3 id="facet-label-{{ facet_id }}"
        class="text-xs font-semibold uppercase tracking-wide text-muted-foreground mb-2">
      {{ facet_id | replace('_', ' ') | title }}
    </h3>

    {% if buckets | length > 8 %}
    {# Champ de recherche dans la facette — filtrage JS inline #}
    <input type="search"
           placeholder="Filtrer…"
           aria-label="Filtrer les valeurs de {{ facet_id | replace('_', ' ') }}"
           oninput="filterFacet(this, '{{ section_id }}-list')"
           class="w-full mb-2 px-2 py-1 text-xs rounded border border-border bg-muted text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-1 focus:ring-ring" />
    {% endif %}

    <ul id="{{ section_id }}-list" class="space-y-1 max-h-60 overflow-y-auto">
      {% for item in buckets %}
      {% set item_key = item.key %}
      {% set item_count = item.doc_count %}
      {% set is_active = filters | selectattr('identifier', 'equalto', facet_id) | selectattr('value', 'equalto', item_key) | list | length > 0 %}

      {% if is_active %}
      {# Filtre actif — lien pour le retirer #}
      {% set new_filters = filters | rejectattr('identifier', 'equalto', facet_id) | list %}
      <li data-facet-value="{{ item_key | lower }}">
        <a href="/api/v1/hypermedia/search?q={{ q | urlencode }}{% for f in new_filters %}&amp;filter={{ f.identifier }}:{{ f.value | urlencode }}{% endfor %}"
           hx-get="/api/v1/hypermedia/search/results?q={{ q | urlencode }}{% for f in new_filters %}&amp;filter={{ f.identifier }}:{{ f.value | urlencode }}{% endfor %}"
           hx-target="#search-results"
           hx-push-url="true"
           class="flex items-center justify-between w-full rounded px-2 py-1 text-sm bg-primary/10 text-primary font-medium"
           aria-label="Retirer le filtre {{ facet_id }}: {{ item_key }}"
           aria-pressed="true">
          <span>{{ item_key }}</span>
          <span class="flex items-center gap-1 ml-2">
            <span class="text-xs text-primary/70">({{ item_count }})</span>
            <span aria-hidden="true" class="text-xs">✕</span>
          </span>
        </a>
      </li>

      {% else %}
      {# Filtre inactif — lien pour l'ajouter #}
      <li data-facet-value="{{ item_key | lower }}">
        <a href="/api/v1/hypermedia/search?q={{ q | urlencode }}&amp;filter={{ facet_id }}:{{ item_key | urlencode }}{% for f in filters %}&amp;filter={{ f.identifier }}:{{ f.value | urlencode }}{% endfor %}"
           hx-get="/api/v1/hypermedia/search/results?q={{ q | urlencode }}&amp;filter={{ facet_id }}:{{ item_key | urlencode }}{% for f in filters %}&amp;filter={{ f.identifier }}:{{ f.value | urlencode }}{% endfor %}"
           hx-target="#search-results"
           hx-push-url="true"
           class="flex items-center justify-between w-full rounded px-2 py-1 text-sm text-foreground hover:bg-muted transition-colors"
           aria-label="Filtrer par {{ facet_id }}: {{ item_key }} ({{ item_count }} résultats)">
          <span>{{ item_key }}</span>
          <span class="text-xs text-muted-foreground ml-2">({{ item_count }})</span>
        </a>
      </li>
      {% endif %}

      {% endfor %}
    </ul>
  </section>
  {% endif %}
  {% endfor %}
</aside>

{% else %}
{# OOB : réinitialise la sidebar si pas de facettes #}
{% endif %}
