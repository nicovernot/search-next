{% extends "layouts/base.j2" %}

{% block title %}{% if q %}{{ q }} — {% endif %}OpenEdition Search{% endblock %}

{% block content %}
<section aria-label="Formulaire de recherche">
  <div class="glass rounded-3xl premium-shadow p-2 mb-6">
    <form id="search-form"
          hx-get="/api/v1/hypermedia/search"
          hx-target="#search-results"
          hx-push-url="true"
          hx-indicator="#loading"
          class="flex gap-2">
      <label for="search-input" class="sr-only">Rechercher</label>
      <input id="search-input"
             type="search"
             name="q"
             value="{{ q }}"
             placeholder="Rechercher dans OpenEdition…"
             autocomplete="off"
             class="flex-1 bg-transparent px-4 py-2 text-sm text-foreground placeholder:text-muted-foreground focus:outline-none"
             aria-label="Terme de recherche" />
      <button type="submit"
              class="rounded-2xl px-5 py-2 text-sm font-medium transition-colors bg-highlight text-white hover:bg-highlight/90"
              aria-label="Lancer la recherche">
        Rechercher
      </button>
    </form>
  </div>

  {# Filtres actifs #}
  {% if filters %}
  <div class="flex flex-wrap gap-2 mb-4" aria-label="Filtres actifs">
    {% for f in filters %}
    {% set remaining = filters | rejectattr('identifier', 'equalto', f.identifier) | list %}
    {% set remaining = remaining | rejectattr('value', 'equalto', f.value) | list %}
    <a href="/api/v1/hypermedia/search?q={{ q | urlencode }}{% for r in remaining %}&amp;filter={{ r.identifier }}:{{ r.value | urlencode }}{% endfor %}"
       class="inline-flex items-center gap-1 rounded-full bg-primary/10 text-primary px-3 py-1 text-xs font-medium"
       aria-label="Retirer le filtre {{ f.identifier }}: {{ f.value }}">
      {{ f.identifier }}: {{ f.value }} <span aria-hidden="true">✕</span>
    </a>
    {% endfor %}
  </div>
  {% endif %}
</section>

<div id="loading"
     class="htmx-indicator flex items-center gap-2 text-sm text-muted-foreground mb-4"
     aria-live="polite"
     aria-label="Chargement en cours">
  <svg class="animate-spin h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"/>
  </svg>
  Chargement…
</div>

<div class="flex gap-6">
  {# Panneau facettes — mis à jour via OOB swap depuis results.j2 #}
  <div id="facets" class="w-48 flex-shrink-0" aria-label="Filtres de recherche">
    {% if facets %}{% include "fragments/facets.j2" %}{% endif %}
  </div>

  {# Résultats #}
  <div id="search-results" class="flex-1 min-w-0" aria-live="polite" aria-busy="false" _="on htmx:beforeRequest set @aria-busy to 'true' on htmx:afterRequest set @aria-busy to 'false'">
    {% include "fragments/results.j2" %}
  </div>
</div>
{% endblock %}
