<!DOCTYPE html>
<html lang="{{ lang | default('fr') }}">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{% block title %}OpenEdition Search{% endblock %}</title>

  <link rel="stylesheet" href="/static/hypermedia/styles.css" />

  {% block head %}{% endblock %}
</head>
<body class="min-h-screen bg-background text-foreground transition-colors">

  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:bg-background focus:text-primary focus:px-4 focus:py-2 focus:rounded focus:shadow-lg">Aller au contenu principal</a>

  <header class="glass premium-shadow rounded-2xl mx-2 mt-2 px-6 py-3 flex items-center justify-between sticky top-2 z-10">
    <a href="/api/v1/hypermedia/" class="font-semibold text-lg tracking-tight text-foreground">
      <span>Open</span><span class="text-primary">Edition</span> Search
    </a>
    <button onclick="toggleDark()"
            id="dark-toggle"
            class="text-sm text-muted-foreground transition-colors hover:text-foreground"
            aria-label="Basculer le thème sombre">
      🌙
    </button>
  </header>

  <main id="main-content" hx-history-elt class="max-w-5xl mx-auto px-6 py-8">
    {% block content %}{% endblock %}
  </main>

  {# HTMX #}
  <script src="https://unpkg.com/htmx.org@2.0.4/dist/htmx.min.js"></script>

  <script>
    // Config HTMX — historique navigateur
    htmx.config.historyCacheSize = 20;
    htmx.config.refreshOnHistoryMiss = true;

    // Dark mode — appliqué avant le rendu pour éviter le flash
    (function () {
      var dark = localStorage.getItem('dark') === 'true';
      if (dark) document.documentElement.classList.add('dark');
    })();
    function toggleDark() {
      var dark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('dark', dark);
      document.getElementById('dark-toggle').textContent = dark ? '☀️' : '🌙';
    }
    document.addEventListener('DOMContentLoaded', function () {
      var dark = document.documentElement.classList.contains('dark');
      document.getElementById('dark-toggle').textContent = dark ? '☀️' : '🌙';
    });

    // Filtre inline des valeurs de facette
    function filterFacet(input, listId) {
      var term = input.value.toLowerCase();
      var items = document.getElementById(listId).querySelectorAll('li[data-facet-value]');
      items.forEach(function (li) {
        li.style.display = li.dataset.facetValue.includes(term) ? '' : 'none';
      });
    }
  </script>

  {% if debug %}
  <script>htmx.logAll();</script>
  {% endif %}

</body>
</html>
