<!DOCTYPE html>
<html lang="{{ lang | default('fr') }}" x-data="{ dark: localStorage.getItem('dark') === 'true' }" x-init="$watch('dark', v => localStorage.setItem('dark', v))" :class="{ 'dark': dark }">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{% block title %}OpenEdition Search{% endblock %}</title>

  {# Tailwind CSS — CDN dev uniquement, remplacer par le build local en production #}
  <script src="https://cdn.tailwindcss.com"></script>
  <script>tailwind.config = { darkMode: 'class' }</script>

  {# HTMX #}
  <script src="https://unpkg.com/htmx.org@2.0.4/dist/htmx.min.js" defer></script>

  {# Alpine.js #}
  <script src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js" defer></script>

  {% block head %}{% endblock %}
</head>
<body class="min-h-screen bg-white dark:bg-gray-950 text-gray-900 dark:text-gray-100 transition-colors">

  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:bg-white focus:text-blue-700 focus:px-4 focus:py-2 focus:rounded focus:shadow-lg">Aller au contenu principal</a>

  <header class="border-b border-gray-200 dark:border-gray-800 px-6 py-3 flex items-center justify-between">
    <a href="/api/v1/hypermedia/" class="font-semibold text-lg tracking-tight">OpenEdition Search</a>
    <button @click="dark = !dark"
            class="text-sm text-gray-500 hover:text-gray-900 dark:hover:text-white transition-colors"
            aria-label="Basculer le thème sombre">
      <span x-show="!dark">🌙</span>
      <span x-show="dark">☀️</span>
    </button>
  </header>

  <main id="main-content" class="max-w-5xl mx-auto px-6 py-8">
    {% block content %}{% endblock %}
  </main>

  {% if debug %}
  <script>htmx.logAll();</script>
  {% endif %}

</body>
</html>
