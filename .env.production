# Modèle de configuration — environnement PRODUCTION
# Fichier autonome et complet (aucune dépendance à .env.shared, supprimé).
# Activation : scripts/use-env.sh production (copie ce fichier vers .env, racine, + symlinks front/.env et search_api_solr/.env)
#
# ⚠️ SÉCURITÉ : les valeurs marquées "change-me-in-production" sont des placeholders.
# Le backend refuse de démarrer (env_validation.py) si l'une d'elles est encore active
# alors que ENVIRONMENT=production. Surchargez-les impérativement au déploiement réel
# (variables d'environnement système / gestionnaire de secrets), ne committez jamais la vraie valeur.

ENVIRONMENT=production
NODE_ENV=production

# --- Général / backend ---
DEBUG=false
AUTO_RELOAD=false
LOG_LEVEL=INFO
DISABLE_AUTH=false

# --- URLs de service ---
# Derrière nginx (reverse proxy) : le front et l'API partagent la même origine publique.
API_BASE_URL=/api
NEXT_PUBLIC_API_URL=/api
FRONTEND_URL=https://search.openedition.org

# --- CORS ---
# Valeur retenue par défaut (cf. specs/018-simplify-env-config/contracts/env-schema.md, T002) :
# à valider par l'équipe infra avant déploiement réel.
CORS_ORIGINS=https://search.openedition.org

# --- Solr ---
SOLR_URL=http://solr-prod:8983/solr
SOLR_BASE_URL=https://solrslave-sec.labocleo.org/solr/documents
SOLR_COLLECTION=searchv2_prod

# --- Base de données / cache ---
# Mot de passe placeholder — à surcharger via secret manager au déploiement.
DATABASE_URL=postgresql://search_user:change-me-in-production@postgres:5432/search_db
REDIS_URL=redis://redis:6379/0
REDIS_ENABLED=true
REDIS_TTL_SEARCH=300
REDIS_TTL_SUGGEST=3600
REDIS_TTL_PERMISSIONS=1800

# --- Sécurité applicative (placeholders — surcharge obligatoire, cf. bandeau ci-dessus) ---
SECRET_KEY=change-me-in-production
JWT_SECRET=change-me-in-production
SESSION_SECRET=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Auth externe ---
AUTH_API_URL=https://auth.openedition.org/auth_by_url/

# --- LDAP (désactivé par défaut — activer et surcharger les secrets si utilisé en prod) ---
LDAP_ENABLED=false
LDAP_URL=ldaps://ldap.example.org:636
LDAP_BASE_DN=dc=example,dc=org
LDAP_BIND_DN=cn=service,dc=example,dc=org
LDAP_BIND_PASSWORD=change-me-in-production
LDAP_USER_FILTER=(uid={username})
LDAP_EMAIL_ATTR=mail
LDAP_FIRSTNAME_ATTR=givenName
LDAP_LASTNAME_ATTR=sn
LDAP_EMAIL_CONFLICT_STRATEGY=reject
NEXT_PUBLIC_LDAP_ENABLED=false

# --- SSO OIDC (désactivé par défaut — activer et surcharger les secrets si utilisé en prod) ---
SSO_OIDC_ENABLED=false
SSO_OIDC_ISSUER=https://sso.example.org
SSO_OIDC_CLIENT_ID=openedition-search
SSO_OIDC_CLIENT_SECRET=change-me-in-production
SSO_OIDC_REDIRECT_URI=https://search.openedition.org/auth/sso/callback
SSO_OIDC_SCOPES=openid email profile
NEXT_PUBLIC_SSO_ENABLED=false

# --- Performance (valeurs par défaut, cf. contracts/env-schema.md T002 — à valider par l'infra) ---
WORKER_COUNT=4
CACHE_TTL=3600
RATE_LIMIT=1000
